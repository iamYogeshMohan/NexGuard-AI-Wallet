# ==============================================================================
# NEXGUARD SECURE WALLET — ENVIRONMENT CONFIGURATION
# ==============================================================================

# ─── Application Identity ─────────────────────────────────────────────────────
APP_NAME="NexGuard Secure Wallet"
APP_VERSION=2.0.0
ENVIRONMENT=development

# ─── Database Configuration ───────────────────────────────────────────────────
# SQLite (Default for quick local development without Docker):
DATABASE_URL=sqlite:///./nexguard.db

# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql://nexguard:nexguard_password_2024@localhost:5432/nexguard_wallet

# ─── JWT Authentication ───────────────────────────────────────────────────────
SECRET_KEY=nexguard-super-secret-jwt-key-change-in-production-32chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ─── Risk Decision Engine Thresholds (Master Build Prompt §14) ────────────────
# 0–30: ALLOW (Instant Settlement)
# 31–60: VERIFY (Step-Up Adaptive Biometric Authentication)
# 61–100: BLOCK (Aborted + Incident INC-XXXX Generated)
RISK_ALLOW_MAX=30
RISK_VERIFY_MAX=60

# ─── Multi-Device Local Area Network (LAN) Configuration ─────────────────────
# To access NexGuard on physical phones (Phone A, Phone B, Phone C) over Wi-Fi:
# 1. Open Command Prompt on Windows and run: ipconfig
# 2. Find your "IPv4 Address" under Wireless LAN adapter Wi-Fi (e.g., 192.168.1.100)
# 3. Ensure your phone and laptop are connected to the SAME Wi-Fi network
# 4. Set the frontend API URL to your laptop's IP address:
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/soc

# For mobile LAN testing:
# NEXT_PUBLIC_API_URL=http://192.168.1.100:8000
# NEXT_PUBLIC_WS_URL=ws://192.168.1.100:8000/ws/soc
